# Default provider is Ollama (local, no cloud dependency, matches the
# capstone brief) — no env vars are required for that case beyond having
# `ollama serve` running with a model pulled.

# Uncomment to use Groq instead (needed for a publicly deployed instance,
# since Ollama on your own machine isn't reachable from a public URL):
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key-here

# Optional Ollama overrides:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=180

PORT=8000
